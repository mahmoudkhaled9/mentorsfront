# PRODUCTION build settings. Copy to .env.production (git-ignored) before `npm run build` for a real deployment.
# DEPLOYMENT REQUIREMENT (not decided yet): the HTTPS address of the production API, ending in /api.
# Without it the build falls back to http://localhost:4001/api and warns: that bundle only works on a developer machine.
VITE_API_BASE=<https://api-host>/api
