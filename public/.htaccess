# PDF import loads pdf.js's worker (assets/pdf.worker.min-*.mjs) as a JavaScript module. Browsers refuse a module
# served as application/octet-stream, which some Apache setups use for .mjs: declare the type explicitly.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Security headers (the Content-Security-Policy itself is a <meta> tag in index.html, added by the production build;
# frame-ancestors can only be sent as a header).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Long cache for fingerprinted build files (assets/index-AbC123.js), never for index.html, so a new release is
  # picked up on the next page load.
  <FilesMatch "\.(js|mjs|css|jpg|jpeg|png|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
